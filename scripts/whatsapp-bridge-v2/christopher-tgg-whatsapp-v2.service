[Unit]
Description=Christopher TGG WhatsApp bridge v2 (read-only metadata collector)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=pclaw
Group=pclaw
WorkingDirectory=/home/pclaw/apps/hermes-pcl/scripts/whatsapp-bridge-v2
Environment=HOME=/home/pclaw
Environment=USER=pclaw
Environment=LOGNAME=pclaw
Environment=WHATSAPP_MODE=bot
Environment=WHATSAPP_ALLOWED_USERS=*
Environment=WHATSAPP_OUTBOUND_DISABLED=false
Environment=WHATSAPP_OUTBOUND_ALLOWED_CHATS=
Environment=WHATSAPP_GROUP_CREATE_ENABLED=true
Environment=WHATSAPP_GROUP_CREATE_MAX_PARTICIPANTS=10
EnvironmentFile=-/home/pclaw/.hermes-christopher-tgg/outbound-policy.env
Environment=WHATSAPP_SYNC_FULL_HISTORY=true
Environment=WHATSAPP_HISTORY_TO_LIVE_QUEUE=false
Environment=WHATSAPP_MAX_QUEUE_SIZE=5000
Environment=WHATSAPP_STORE_FILE=/home/pclaw/.hermes-christopher-tgg/whatsapp-v2/message-store.json
Environment=WHATSAPP_HISTORY_SYNC_PATH=/home/pclaw/.hermes-christopher-tgg/whatsapp-v2/history-sync.jsonl
Environment=WHATSAPP_HISTORY_METADATA_PATH=/home/pclaw/.hermes-christopher-tgg/whatsapp-v2/history-metadata.jsonl
ExecStart=/usr/bin/node bridge.js --port 3001 --session /home/pclaw/.hermes-christopher-tgg/whatsapp-v2/session --mode bot
Restart=always
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=90
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
