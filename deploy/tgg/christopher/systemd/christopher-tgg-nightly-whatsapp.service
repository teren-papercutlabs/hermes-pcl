[Unit]
Description=Christopher TGG nightly WhatsApp six-session shadow investigation launcher
After=network-online.target christopher-tgg-hermes.service systems-papercut-labs.service
Wants=network-online.target

[Service]
Type=oneshot
User=pclaw
Group=pclaw
SupplementaryGroups=tggcapture
WorkingDirectory=/home/pclaw/apps/hermes-pcl
Environment=HOME=/home/pclaw
Environment=HERMES_HOME=/home/pclaw/.hermes-christopher-tgg
EnvironmentFile=/home/pclaw/.hermes-christopher-tgg/.env
ExecStartPre=+/usr/bin/chmod 0660 /var/lib/tgg-capture/whatsapp/capture/events.jsonl
ExecStart=/home/pclaw/apps/hermes-pcl/.venv/bin/python /home/pclaw/.hermes-christopher-tgg/runtime/capabilities/christopher-tgg/current/scripts/run-nightly-whatsapp.py
TimeoutStartSec=3h
Restart=on-failure
RestartSec=5min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/tgg-capture/whatsapp/capture /home/pclaw/.hermes-christopher-tgg/runtime
