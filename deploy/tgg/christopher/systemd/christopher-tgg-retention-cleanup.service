[Unit]
Description=Christopher TGG retention cleanup dry-run receipt
After=local-fs.target

[Service]
Type=oneshot
User=pclaw
Group=pclaw
WorkingDirectory=/home/pclaw/apps/hermes-pcl
Environment=HOME=/home/pclaw
Environment=HERMES_HOME=/home/pclaw/.hermes-christopher-tgg
ExecStart=/home/pclaw/apps/hermes-pcl/.venv/bin/python /home/pclaw/apps/hermes-pcl/deploy/tgg/christopher/scripts/retention_cleanup.py --policy /home/pclaw/apps/hermes-pcl/deploy/tgg/christopher/retention-policy.tgg-app-1.yaml --receipt-dir /home/pclaw/.systems-pcl/data/retention-receipts
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/pclaw/.systems-pcl/data/retention-receipts
StandardOutput=journal
StandardError=journal
