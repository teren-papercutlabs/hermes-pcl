[Unit]
Description=Christopher TGG Hermes durable capture consumer (processing gated)
After=network-online.target tailscaled.service tgg-capture-whatsapp-bridge.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=pclaw
Group=pclaw
SupplementaryGroups=tggcapture
WorkingDirectory=/opt/tgg-christopher/runtime/current
Environment=HOME=/home/pclaw
Environment=USER=pclaw
Environment=LOGNAME=pclaw
Environment=HERMES_HOME=/home/pclaw/.hermes-christopher-tgg
Environment=PATH=/home/pclaw/apps/hermes-pcl/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=VIRTUAL_ENV=/home/pclaw/apps/hermes-pcl/.venv
Environment=PYTHONDONTWRITEBYTECODE=1
# Scheduled management work uses the same guarded local bridge as durable
# consumer replies; Hermes's generic WhatsApp adapter intentionally remains off.
Environment=TGG_REPLY_BRIDGE_URL=http://127.0.0.1:3011
EnvironmentFile=/home/pclaw/.hermes-christopher-tgg/.env
ExecStartPre=+/home/pclaw/apps/hermes-pcl/.venv/bin/python /opt/tgg-christopher/runtime/current/deploy/tgg/christopher/scripts/apply_engine_slot.py --app-root /opt/tgg-christopher/runtime/current --hermes-home /home/pclaw/.hermes-christopher-tgg --preserve-host-config
ExecStart=/home/pclaw/apps/hermes-pcl/.venv/bin/python -m gateway.durable_jsonl_consumer run --source /var/lib/tgg-capture/whatsapp/capture/events.jsonl --cursor /home/pclaw/.hermes-christopher-tgg/runtime/capture-cursor.json --inbox /home/pclaw/.hermes-christopher-tgg/runtime/capture-inbox.db --config /home/pclaw/.hermes-christopher-tgg/config.yaml --state-db /home/pclaw/.hermes-christopher-tgg/state.db --case-db /home/pclaw/.systems-pcl/data/tenants/tgg.db --source-before-image-dir /home/pclaw/.hermes-christopher-tgg/runtime/source-evidence-before-images --processing-gate /home/pclaw/.hermes-christopher-tgg/runtime/processing-gate.json --lock-file /home/pclaw/.hermes-christopher-tgg/runtime/capture-consumer.lock --activity-lock-file /opt/tgg-christopher/release-activity.lock --status-file /home/pclaw/.hermes-christopher-tgg/runtime/capture-consumer-status.json --poll-seconds 2 --max-records 100 --site-concurrency 4 --chat-batch-size 25
Restart=on-failure
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=60
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadOnlyPaths=/var/lib/tgg-capture
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
